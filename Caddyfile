# Public edge for Evokz ACE.
#
# `{$VAR}` placeholders are substituted from the container environment at parse
# time — see the caddy service's env_file in docker-compose.yml.
{
	email {$ACME_EMAIL}

	# Caddy's admin API binds localhost:2019 inside the container. Nothing
	# publishes it, but disabling it removes the surface outright.
	admin off

	# The automatic HTTP->HTTPS redirect is a catch-all, not a per-site route:
	# with it on, port 80 answered `308 Location: https://<whatever>` for *any*
	# Host header, including the names freed below. Measured, not assumed. That
	# is a response on behalf of a domain this server does not serve, so it is
	# disabled here and restated explicitly for our one name.
	#
	# ACME is unaffected — the HTTP-01 challenge handler is registered by the
	# issuer, not by the redirect, and TLS-ALPN-01 remains as a fallback.
	auto_https disable_redirects
}

# `{host}` rather than `{$APP_DOMAIN}` so this stays correct if the variable
# ever holds more than one name again.
http://{$APP_DOMAIN} {
	redir https://{host}{uri} permanent
}

{$APP_DOMAIN} {
	encode zstd gzip

	# --- Origin ----------------------------------------------------------
	# No Basic Auth here. There used to be a second, outer gateway lock at this
	# layer, which meant an operator answered a browser popup (user + password)
	# and *then* the console's own sign-in form — two credentials to reach one
	# page. It was removed deliberately: the app's login in `src/middleware.ts`
	# now stands alone.
	#
	# What that costs is worth stating plainly. The middleware fails closed and
	# covers every path except the two self-authenticating machine endpoints
	# below, so nothing is exposed that was not exposed before — but online
	# password guessing now reaches the app itself, where the only brake is the
	# per-IP throttle in `src/app/login/actions.ts` (8 attempts / 15 min, and
	# in-memory, so a container restart clears it). Keep the console password
	# long, and put the gateway back if this origin ever starts getting probed.
	#
	# `/api/webhooks/razorpay` and `/api/cron` were the two paths carved out of
	# the old lock, because Razorpay signs its body with HMAC-SHA256 and the cron
	# sweep sends `Authorization: Bearer $CRON_SECRET` — neither can answer a
	# Basic Auth challenge. They still authenticate their own callers and still
	# fail closed; they simply no longer need a special case here.
	reverse_proxy app:3000

	# Headroom over the 8 MB Server Action body limit set in next.config.mjs, so
	# an oversized logo upload is rejected by the app's own message rather than
	# by a bare 413 from the edge. Caddy applies no response timeout by default,
	# which is what a 300s dispatch sweep needs.
	request_body {
		max_size 10MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

# --- No other names are served here ----------------------------------------
# `app.evokz.in` is the only host this VPS answers on. There used to be a second
# block that 301'd `evokz.in` / `www.evokz.in` to the console, and `APP_DOMAIN`
# also carried `app.brivokz.com` as a stand-in while `evokz.in` was filtered on
# Indian networks. Both were removed on 2026-08-06: the apex and the brivokz.com
# subdomain are being freed for unrelated sites, and a redirect would have kept
# claiming them.
#
# Over HTTPS an unknown name already fails the handshake — Caddy holds no
# certificate for a name it does not serve. Over HTTP it does not fail: Caddy's
# default for a request matching no route is an empty `200 OK`, which reads as a
# live site to anything that only checks a status code. This catch-all turns that
# into a closed connection, so the box answers for one name and no other.
#
# `:80` is less specific than `http://{$APP_DOMAIN}` above, and Caddy orders
# host-matched routes ahead of catch-alls, so the console keeps its redirect.
#
# The ACME carve-out is belt and braces. `auto_https` injects the HTTP-01
# challenge handler ahead of user routes, so this should never see a challenge —
# but a wrong assumption there would not surface until a renewal failed ~60 days
# out, silently, and that is not a thing to leave to memory.
#
# None of this releases a domain. The A record does; this only stops the server
# from responding while one still points here.
:80 {
	@not-acme not path /.well-known/acme-challenge/*
	abort @not-acme
}
