# Edge configuration — read only by the `caddy` service in docker-compose.yml.
#
# Values here must never contain a `$`: Docker Compose interpolates env_file
# contents, so `$anything` is replaced with an environment lookup — silently,
# leaving a value that is merely wrong rather than an error. Nothing secret
# belongs in this file; the console password is hashed into `.env` instead.

# Site address Caddy answers on and requests a certificate for. Must resolve to
# this VPS via an A record before the stack starts, or ACME validation fails.
# Add www only once a second A record exists:  APP_DOMAIN="evokz.in, www.evokz.in"
APP_DOMAIN="app.brivokz.com, app.evokz.in"

# Let's Encrypt expiry notices go here.
ACME_EMAIL="you@example.com"

# Names that should 301 to APP_DOMAIN instead of serving the console. Leave the
# console on a subdomain and the apex free for a separate marketing site.
REDIRECT_DOMAIN="evokz.in, www.evokz.in"
