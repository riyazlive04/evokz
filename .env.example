# ---------------------------------------------------------------------------
# Database (PostgreSQL via Prisma)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/evokz_ace?schema=public"

# ---------------------------------------------------------------------------
# Scheduling
# ---------------------------------------------------------------------------
# IANA timezone used to resolve every client's `cronTime` (HH:MM) and to
# resolve "today" when matching ContentCalendar.scheduledDate.
APP_TIMEZONE="Asia/Kolkata"
# Shared secret required on GET/POST /api/cron as `Authorization: Bearer ...`
# (Vercel Cron sends this header automatically when CRON_SECRET is set).
CRON_SECRET="replace-with-a-long-random-string"

# --- Campaign poster generation (optional) ----------------------------------
# Posters queued from a campaign board are generated by the dispatch sweep, a
# few per tick, so the browser can close. Each is an image model call plus Drive
# writes inside one sweep request (capped at 300s).
# Days generated per sweep. Default 4.
# CAMPAIGN_GENERATION_LIMIT="4"
# How many of those run at once. Default 1, capped at 4.
# CAMPAIGN_GENERATION_CONCURRENCY="1"

# ---------------------------------------------------------------------------
# Razorpay
# ---------------------------------------------------------------------------
RAZORPAY_WEBHOOK_SECRET="whsec_from_razorpay_dashboard"

# ---------------------------------------------------------------------------
# Google Drive (single central service account)
# ---------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL="evokz-ace@your-project.iam.gserviceaccount.com"
# Paste the full PEM. Literal "\n" sequences are unescaped at runtime, so the
# single-line form copied out of the service-account JSON works as-is.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
# Parent folder ("Evokz_Engine_Vault"). Must be shared with the service account
# as Content manager / Editor. Required for Shared Drives.
GOOGLE_DRIVE_PARENT_FOLDER_ID="1AbCdEfGhIjKlMnOpQrStUvWxYz"

# ---------------------------------------------------------------------------
# OpenAI (brand tokenizer + content calendar copywriting)
# ---------------------------------------------------------------------------
OPENAI_API_KEY="sk-..."
# Replaces the blueprint's Claude 3.5 Sonnet (retired 2025-10-28).
OPENAI_MODEL="gpt-4o-mini"
# Per-request output cap. gpt-4o-mini's ceiling is 16384; values above that are
# clamped in code.
OPENAI_MAX_TOKENS="8000"
OPENAI_MAX_ATTEMPTS="3"
# Optional. Vision model that reads a template's elements (headline, photo, logo,
# contact lines) when it is uploaded or re-read. Default gpt-5.4; gpt-4o misplaces
# the boxes. Must be vision-capable.
# OPENAI_TEMPLATE_ELEMENTS_MODEL="gpt-5.4"
# Optional. Vision model that reads a generated poster's text back to check it.
# Default gpt-5.4.
# OPENAI_TEXT_CHECK_MODEL="gpt-5.4"

# ---------------------------------------------------------------------------
# AI Poster Studio (/admin/poster-studio) — optional
# ---------------------------------------------------------------------------
# Uses OPENAI_API_KEY above with gpt-image-2 (pinned in code, because the output
# sizes are gpt-image-2-only), and the Google Drive credentials above for storage.
# Render quality: low | medium | high | auto. Defaults to low, the cheapest; cost
# scales with quality, and the API's own default of auto may choose high.
# Campaign posters cloned from a template always render at high, whatever this says.
# POSTER_STUDIO_IMAGE_QUALITY="low"
# Drive folder to store studio images in, instead of a "Poster Studio" folder
# under GOOGLE_DRIVE_PARENT_FOLDER_ID. Point a development machine at a scratch
# folder here so test images never land in the shared vault.
# POSTER_STUDIO_DRIVE_FOLDER_ID="1AbCdEfGhIjKlMnOpQrStUvWxYz"

# ---------------------------------------------------------------------------
# Default poster size
# ---------------------------------------------------------------------------
# Fleet-wide default output-size preset, used only by clients with no size of
# their own, and only for a campaign day with no template — a templated day takes
# its template's shape. The name is kept from the retired fal.ai renderer; fal.ai
# itself is no longer called.
#
# A preset id from src/lib/image-sizes.ts. Unset or unknown falls back to
# "whatsapp-status".
#   Social:    whatsapp-status whatsapp-chat instagram-story instagram-portrait
#              instagram-square instagram-landscape facebook-story
#              facebook-portrait facebook-square facebook-link facebook-cover
#              linkedin-portrait linkedin-square linkedin-landscape
#              linkedin-banner x-post youtube-thumbnail pinterest-pin
#   Wallpaper: mobile-fhd mobile-tall mobile-qhd tablet-portrait
#              tablet-pro-portrait tablet-landscape laptop-fhd laptop-16-10
#              laptop-retina desktop-qhd desktop-4k desktop-ultrawide
#   Print:     print-a4-portrait print-a4-landscape
FAL_IMAGE_SIZE="whatsapp-status"

# ---------------------------------------------------------------------------
# Evolution API (WhatsApp gateway) — Evolution GO
# ---------------------------------------------------------------------------
# Evolution GO exposes POST /send/media (not the Node v2
# /message/sendMedia/{instance}) and selects the instance from the API key,
# so there is no instance-name setting.
EVOLUTION_API_URL="https://evolution.your-domain.com"
# MUST be the per-INSTANCE token (from GET /instance/all -> data[].token).
# The global admin key is rejected with 401 on instance-scoped routes.
EVOLUTION_API_KEY="your_instance_token"
EVOLUTION_TIMEOUT_MS="60000"

# ---------------------------------------------------------------------------
# Public origin (campaign poster delivery)
# ---------------------------------------------------------------------------
# This deployment's public origin, used to build the temporary signed link that
# WhatsApp fetches a campaign poster from.
#
# Why it is needed: Evolution downloads media server-side and holds no Google
# credential, and campaign posters are stored in Drive UNPUBLISHED on purpose.
# Rather than making them world-readable, each send mints a signed link to
# /api/campaign-media/<token> that names one poster, expires in 30 minutes and
# streams the bytes through the service account.
#
# Must be reachable by the Evolution server — a localhost value works only when
# the gateway runs on the same host. Campaign delivery refuses to send while
# this is unset rather than guessing an origin.
PUBLIC_BASE_URL="https://console.your-domain.com"

# ---------------------------------------------------------------------------
# Cost tracking rate card
# ---------------------------------------------------------------------------
# Drives every figure in the dashboard's spend panel. These are DEFAULTS, not
# quotes — check them against your own provider invoices. The panel prints the
# rate card it used so a mismatch is visible rather than silent.
# USD per 1M OpenAI tokens.
PRICE_OPENAI_INPUT_PER_MTOK="0.15"
PRICE_OPENAI_CACHED_INPUT_PER_MTOK="0.075"
PRICE_OPENAI_OUTPUT_PER_MTOK="0.60"
# USD per 1M tokens for AI Poster Studio images (gpt-image-2): text input, image
# input, image output. Deliberately NO defaults. Until all three are set, studio
# images are recorded with exact token counts and no price, and the spend panel
# reports them as "not priced" — take the figures from OpenAI's current pricing
# page and reconcile against the OpenAI billing dashboard.
# PRICE_OPENAI_IMAGE_TEXT_INPUT_PER_MTOK=""
# PRICE_OPENAI_IMAGE_IMAGE_INPUT_PER_MTOK=""
# PRICE_OPENAI_IMAGE_OUTPUT_PER_MTOK=""
# USD per fal.ai image and per fal.ai background-removal call. fal.ai is no longer
# called; these only price the spend history the retired renderer recorded.
PRICE_FAL_PER_IMAGE="0.003"
PRICE_FAL_PER_CUTOUT="0.0004"
# USD per WhatsApp message. 0 for a self-hosted Evolution instance.
PRICE_WHATSAPP_PER_MESSAGE="0"
# Display-only conversion for the rupee column.
USD_INR_RATE="88"

# ---------------------------------------------------------------------------
# Poster renderer (satori + resvg)
# ---------------------------------------------------------------------------
# The text layer composited over every background photo. Nothing here is
# required — the defaults work — but each variable removes a failure mode.
#
# Directory of TTF/OTF files, checked before Google Fonts. Files are looked up as
# "<Family>-<weight>.ttf", e.g. "Inter-400.ttf", "ArchivoBlack-400.ttf".
# Strongly recommended in production: without it, every cold start fetches faces
# from fonts.gstatic.com inside the render path, so a Google outage becomes a
# delivery failure. Self-hosting also removes the User-Agent sniffing that the
# loader relies on to avoid being served unparseable woff2.
POSTER_FONT_DIR=""
# How long to wait for a font file before failing the compose stage.
POSTER_FONT_TIMEOUT_MS="15000"
# How long to wait for a client's logo. On timeout the poster falls back to the
# generated wordmark lockup rather than failing the day's delivery.
POSTER_LOGO_TIMEOUT_MS="15000"

# ---------------------------------------------------------------------------
# Admin console authentication  (REQUIRED — the app refuses to serve without it)
# ---------------------------------------------------------------------------
# Generate both with:  node scripts/hash-password.mjs
#
# middleware.ts fails closed: if either value is missing every request gets a
# 503 rather than an open console. That is deliberate — Next.js ships Server
# Action IDs in the public bundle, so an unguarded deployment lets anonymous
# visitors invoke mutations that spend OpenAI/fal.ai credit and message clients.
#
# This password is the ONLY lock. The deployment used to add a Caddy Basic Auth
# gateway in front of the whole origin, so a weak value here still sat behind a
# second credential; that gateway was removed. Choose accordingly — a long
# passphrase costs the operator one paste and costs an attacker everything.
#
# The hash uses `:` separators rather than the conventional `$`, because Next
# expands `$NAME` in .env values and would silently eat the cost field.
ADMIN_PASSWORD_HASH="pbkdf2-sha256:210000:<saltHex>:<hashHex>"
# 32+ random bytes, hex. Rotating this signs out every live session — it is the
# only revocation path, since sessions are stateless signed tokens.
SESSION_SECRET="replace-with-64-hex-characters"

# ---------------------------------------------------------------------------
# No longer read
# ---------------------------------------------------------------------------
# Used only by the retired daily poster maker (fal.ai renders, per-minute
# release, held-back sends, pre-generation backlog, saved fal.ai key) or by its
# layout reader. Nothing in the app reads them now; delete them from an existing
# .env at leisure.
#
#   FAL_KEY  FAL_MODEL_ENDPOINT  FAL_CUTOUT_ENDPOINT  FAL_CUTOUT_MAX_ATTEMPTS
#   FAL_TIMEOUT_MS  FAL_MAX_ATTEMPTS
#   CRON_WINDOW_MINUTES  CRON_MAX_CONCURRENCY
#   CRON_SEND_BATCH_LIMIT  CRON_SEND_CONCURRENCY
#   CRON_BATCH_GENERATE_LIMIT  CRON_BATCH_GENERATE_CONCURRENCY
#   WHATSAPP_SEND_DELAY_MIN_MINUTES  WHATSAPP_SEND_DELAY_MAX_MINUTES
#   SETTINGS_ENCRYPTION_KEY
#   OPENAI_VISION_MODEL  (replaced by OPENAI_TEMPLATE_ELEMENTS_MODEL)
#   CALENDAR_BATCH_SIZE

# ---------------------------------------------------------------------------
# Self-hosted deployment (docker-compose.yml only — unused on a PaaS)
# ---------------------------------------------------------------------------
# Compose interpolates these into the `db` service. DATABASE_URL above must
# point at host `db` (the compose service name), NOT localhost, and must repeat
# the same user/password/database.
#
#   DATABASE_URL="postgresql://evokz:<password>@db:5432/evokz_ace?schema=public"
POSTGRES_USER="evokz"
POSTGRES_PASSWORD="replace-with-a-long-random-string"
POSTGRES_DB="evokz_ace"
