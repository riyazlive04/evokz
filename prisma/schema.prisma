// Evokz ACE — multi-tenant creative automation data layer.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum DeliveryStatus {
  PENDING
  GENERATED
  DELIVERED
  FAILED
}

enum UsageProvider {
  OPENAI // Copy + brand tokenizer, billed per token
  FAL // Flux.1 image synthesis, billed per image
  EVOLUTION // WhatsApp broadcast, billed per message (often self-hosted, ₹0)
}

/// Which credential paid for a call.
///
/// An enum rather than a String: unlike `Client.imageSizePreset`, whose catalogue
/// grows whenever a platform changes a spec, this set is closed and binary. It is
/// also a discriminator the cost report filters on in SQL, where a typo'd string
/// would silently mis-bill rather than fail.
enum UsageKeySource {
  PLATFORM // Evokz's own provider account, from the environment.
  BYO // The operator's own account, from the key stored in AppSetting.
}

model Plan {
  id           String   @id @default(uuid())
  name         String // e.g., "100-Day Blitz", "365-Day Scale"
  durationDays Int
  // Campaign fee in whole rupees for the full duration — not per month. Drives
  // the margin column on the dashboard; null means "not priced yet", which
  // reads as unknown margin rather than zero.
  priceInr     Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  clients      Client[]
}

model Category {
  id        String             @id @default(uuid())
  name      String // e.g., "Real Estate", "Heavy Construction"
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  clients   Client[]
  templates CategoryTemplate[]

  /// The layout every template uploaded to this vertical is given, as a
  /// `PosterLayoutSpec`.
  ///
  /// **What it replaces is a vision call that gets the answer wrong.** Uploading
  /// a template runs an extraction and approves it if it parses, so a new file
  /// reaches clients carrying geometry a model estimated — measured across the
  /// live library, 59 of 60 of those boxes sat on a 0.05 grid, which is a model
  /// describing a poster rather than measuring one.
  ///
  /// A vertical whose templates are all one design does not need any of that:
  /// the layout is known before the file exists. Set here, every upload inherits
  /// it, costs no vision call, and is right by construction. Null leaves the
  /// vertical on extraction, which is still correct for a library of genuinely
  /// different references somebody else drew.
  defaultLayoutSpec Json?
}

/// One operator-uploaded reference poster for a vertical.
///
/// Once an operator states which layout a template represents, it stops being a
/// library and becomes an input: the generator draws that vertical's layouts from
/// the set mapped here, duplicates included, so the mix of compositions a client
/// receives follows the mix of references uploaded for their industry.
model CategoryTemplate {
  id         String   @id @default(uuid())
  categoryId String
  // Cascade, unlike Client's Restrict: a template is derived content that only
  // has meaning inside its vertical, so deleting the vertical should take it.
  // The Drive files are trashed by the action before the rows go.
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  /// Operator-facing name, and the key an imported sheet names a template by.
  ///
  /// Defaults to the uploaded filename, deduped against the vertical on upload
  /// and editable afterwards, because a filename is a poor thing to type into a
  /// spreadsheet three hundred times. Unique per vertical — see the constraint
  /// at the bottom of this model.
  label String

  // Mirrors ContentCalendar's pair, but used differently. Unlike a poster, a
  // reference template is uploaded *unpublished* — it never leaves the console,
  // so nothing outside it should be able to read one. The id is what
  // `/api/templates/[templateId]/thumbnail` fetches with the service account's
  // own credentials; the URL only resolves for a signed-in vault member, and is
  // kept for an operator working in Drive directly.
  gDriveFileId  String
  gDriveViewUrl String

  mimeType String
  /// The stored file's pixel dimensions, measured by `prepareTemplateImage`.
  ///
  /// **Load-bearing, and the console's size badge is the least of it.** These
  /// two numbers become `layoutSpec.aspect` at extraction, and the aspect
  /// decides the shape of every poster drawn from this template — a square
  /// reference delivers a square poster even to a client whose output preset is
  /// 9:16. See `resolvePosterCanvas` in src/lib/poster/canvas.ts.
  ///
  /// Null when the header could not be parsed, which leaves the spec's aspect at
  /// 0 and falls that template's posters back to the client's preset.
  width    Int?
  height   Int?

  /// This template's own geometry, as a `PosterLayoutSpec` (src/lib/types/layout-spec.ts).
  ///
  /// The difference between this and `archetype` is the difference between the
  /// layout the operator uploaded and the nearest of fifteen built-in ones. A
  /// spec is extracted from the image at upload by the vision stage, corrected
  /// by an operator, and only then published — see `layoutApprovedAt`.
  ///
  /// Json rather than columns because the shape is a nested tree, and free-form
  /// because a spec written by an older build must degrade to the archetype
  /// rather than break the vertical: `parseLayoutSpec` returns null for anything
  /// it cannot read, exactly as `loadCategoryArchetypes` drops an unknown
  /// archetype name.
  layoutSpec Json?

  /// The model's band-by-band reading of the poster, kept from extraction.
  ///
  /// Shown beside the draft in the console. Not part of the spec and never read
  /// by the renderer — it exists so an operator looking at a wrong row can see
  /// the reasoning that produced it, which is usually faster than re-deriving
  /// what went wrong from the geometry alone.
  layoutReading String?

  /// When an operator confirmed the extracted spec matches the template.
  ///
  /// **Null means the spec never renders.** Extraction is a vision model reading
  /// a JPEG: it returns a draft, and a draft that silently reached production
  /// would put a misread layout on every poster the vertical ever sends. Null
  /// here falls the template back to its `archetype`, which is the behaviour
  /// that existed before specs.
  layoutApprovedAt DateTime?

  /// Set when this layout was written by hand rather than read from the image.
  ///
  /// Evokz authors its own reference templates, so for those the layout is known
  /// before any file is uploaded and there is nothing to extract. An authored
  /// spec is strictly better than a read one — it is a fixture, rendered at every
  /// preset by `check:layouts` on every run, and it cannot contain a vision
  /// model's confident mistake because no model produced it.
  ///
  /// The column exists so re-reading cannot throw one away by accident, which is
  /// not hypothetical: fourteen templates were re-extracted over an authored
  /// layout in five minutes of clicking, and nothing anywhere said so.
  ///
  /// Written by `scripts/apply-authored-layout.ts`, and by an upload into a
  /// vertical that has a `defaultLayoutSpec` — that upload inherits the standard
  /// layout instead of paying a vision call to estimate it worse, and an
  /// inherited layout needs the same protection as one applied by hand or the
  /// first re-read would quietly put the estimate back. Cleared only by an
  /// operator who confirms a re-read on that one template.
  ///
  /// Consequence worth knowing before reading `extractVerticalLayouts`: once a
  /// vertical's whole library is authored, the bulk "re-read all" sweep skips
  /// every row and can only report zero. The console counts the eligible rows
  /// and says so rather than letting that read as a broken button.
  layoutAuthoredAt DateTime?

  // ---- Clean plate ---------------------------------------------------------
  /// The template's artwork with its own words and photography erased, as a PNG
  /// with transparency where the generated photograph belongs.
  ///
  /// **This is the difference between rebuilding a poster and rendering one.**
  /// `layoutSpec` describes the reference as a grid and the renderer draws an
  /// approximation from that description — which reproduces band structure and
  /// nothing else. Every treatment that makes a template recognisable lives
  /// outside that vocabulary: a photograph masked into a heart, feature items as
  /// rounded cards, a footer with a curved top edge, a gradient behind the type.
  ///
  /// A plate carries all of it as pixels. The generated photograph is composited
  /// *behind* the plate and shows through wherever the operator made it
  /// transparent, so the plate's own alpha does the masking — the heart, the
  /// rounded corners, the curve — with no layout vocabulary at all.
  ///
  /// Null means this template has no plate and renders on the `layoutSpec` grid
  /// path, exactly as before. That is every existing row.
  plateDriveFileId String?
  plateViewUrl     String?
  /// Measured from the stored plate. Load-bearing: the plate's own aspect wins
  /// over the reference's, since the plate is what is actually drawn.
  plateWidth       Int?
  plateHeight      Int?

  /// Where the generated photograph and each block of type go on the plate, as a
  /// `PosterPlateSpec` (src/lib/types/plate-spec.ts). Free-form Json for the same
  /// reason as `layoutSpec`: a spec written by an older build must take one
  /// template out of rotation rather than break the vertical.
  plateSpec Json?

  /// When an operator confirmed the plate's regions are right.
  ///
  /// Its own gate, separate from `layoutApprovedAt`, because the two describe
  /// different artefacts and can be right or wrong independently — a template may
  /// have a sound grid and a plate whose headline box sits over someone's face.
  /// Null means the plate never composites, and the grid path runs.
  plateApprovedAt DateTime?

  /// Whether this template's posters take their colours from the reference or
  /// from the client's brand.
  ///
  /// `client` — the default and the behaviour every existing row has — resolves
  /// fills and type colour from the brand tokenizer, which is what lets one
  /// template serve every tenant (see `LAYOUT_FILLS`). `template` keeps the
  /// reference's own palette, which is what a plate usually wants: a plate is
  /// finished artwork in its designer's colours, and recolouring the type on top
  /// of it to a different brand is how a composite stops looking composed.
  ///
  /// A String rather than an enum, matching `imageSizePreset`: presentation data
  /// whose catalogue may grow, where a migration per addition is the wrong trade.
  paletteSource String @default("client")

  /// Days pinned to this template by name in an imported sheet.
  calendarDays ContentCalendar[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Makes the label addressable from a spreadsheet.
  ///
  /// A sheet names the template it wants per day, so the name has to resolve to
  /// exactly one row. Scoped to the vertical rather than global: two industries
  /// may both reasonably own a "Grand Opening" reference, and a client only ever
  /// draws from its own category.
  @@unique([categoryId, label])
  // Serves the gallery query: every template for one vertical, newest first.
  @@index([categoryId, createdAt])
  // Serves generation's preferred path: approved specs for one vertical.
  @@index([categoryId, layoutApprovedAt])
  // The same query for the plate path.
  @@index([categoryId, plateApprovedAt])
}

model Client {
  id               String   @id @default(uuid())
  companyName      String
  whatsappNumber   String // E.164 without "+", e.g., "919876543210"
  cronTime         String   @default("09:00") // Per-client delivery time (HH:MM)
  startDate        DateTime
  // Last deliverable day, derived from the plan duration AND `deliveryDays` —
  // a weekday-restricted 30-day campaign ends well past 30 calendar days. The
  // dispatch sweep filters on it, so it must move whenever either input changes.
  endDate          DateTime
  // ISO-8601 weekdays this client accepts delivery on (1 = Monday … 7 = Sunday).
  //
  // Empty means every day. That is deliberately the unrestricted value rather
  // than a sentinel: it is what every row predating this column carries, and a
  // client who has expressed no preference must not silently lose days.
  //
  // Only `scheduledDate` computation consults this — the dispatcher already
  // selects by date, so a day with no row simply never sends.
  deliveryDays     Int[]
  isActive         Boolean  @default(true)
  // Sales-demo tenant. Behaves like a client everywhere except the dispatch
  // sweep, which skips it — demo creatives are sent on demand, never on cron.
  isDemo           Boolean  @default(false)
  // Spend cap for the current calendar month, in whole rupees. Null disables
  // the alert for this client rather than treating it as a ₹0 cap.
  monthlyBudgetInr Int?
  brandGuideline   Json? // Extracted design-system tokens
  gDriveFolderId   String? // Client-isolated Google Drive subfolder ID

  // Output-size preset id from src/lib/image-sizes.ts, e.g. "whatsapp-status",
  // "linkedin-portrait", "desktop-4k". A plain String rather than an enum: the
  // catalogue is presentation data that gains entries whenever a platform
  // changes its spec, and each addition would otherwise need a migration.
  // Null means "use the fleet default" (FAL_IMAGE_SIZE, else WhatsApp Status),
  // which is what every row predating this column carries.
  imageSizePreset String?

  // ---- Poster identity -----------------------------------------------------
  // Composited onto every creative by the poster renderer. Kept as real columns
  // rather than inside `brandGuideline` because that column is rewritten
  // wholesale by the brand tokenizer — an operator-uploaded logo must survive a
  // re-extraction.
  //
  // Fetchable image URL for the logo lockup. Populated either by uploading a
  // file (which lands in the client's Drive folder and is published
  // link-readable) or by pasting an existing URL.
  logoUrl         String?
  // Set only when we own the file, so a re-upload can trash the previous one.
  logoDriveFileId String?

  // ---- Background removal --------------------------------------------------
  // An uploaded logo usually arrives as a JPEG or flattened PNG, so it carries a
  // baked-in white rectangle that lands on the poster's ground colour. The
  // uploader keys that background out (src/lib/poster/logo-key.ts) and points
  // logoUrl at the result.
  //
  // The pre-removal file is kept rather than replaced: keying is a judgement
  // call that can be wrong on a logo designed with a deliberate colour block, so
  // "Use original" has to be one click and lossless.
  //
  // `logoUrl` stays the single thing the renderer reads, so these are pointers
  // around it rather than a second source of truth. Exactly two states are legal:
  //
  //   logoBackgroundRemoved = true   logoUrl is a keyed PNG we generated, and
  //                                  logoOriginal* hold the file it came from.
  //   logoBackgroundRemoved = false  logoUrl is the file as supplied, and
  //                                  logoOriginal* are both null.
  //
  // Reverting therefore moves logoOriginal* back into logoUrl and clears them;
  // the keyed file is binned rather than parked, because re-keying the same
  // bytes is deterministic and reproduces it exactly.
  logoOriginalUrl         String?
  logoOriginalDriveFileId String?
  logoBackgroundRemoved   Boolean @default(false)
  // Letterspaced caps line under the logo, e.g. "BUILDING TRUST SINCE 1998".
  brandTagline            String?
  /// Whether the uploaded logo already spells out the company name.
  ///
  /// The poster prints the name under the logo so a client with an icon-only
  /// mark is still identifiable — before this, an uploaded logo replaced the
  /// name entirely and a symbol-only logo left the name nowhere on the creative.
  /// A wordmark logo does carry it, and there the name would read twice, so this
  /// suppresses it.
  ///
  /// Defaults to false, i.e. print the name: a missing company name is invisible
  /// until someone notices it is gone, whereas a doubled one is obvious on the
  /// brand page's own preview and takes one tick to fix.
  logoIncludesName        Boolean @default(false)
  // Contact bar, right cell. Stored as typed, e.g. "www.example.com".
  websiteUrl              String?
  // Contact bar, left cell. Display formatting is preserved verbatim, so
  // "+91 98765 43210" renders with its spacing. Falls back to whatsappNumber.
  displayPhone            String?

  planId       String
  plan         Plan              @relation(fields: [planId], references: [id], onDelete: Restrict)
  categoryId   String
  category     Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  calendarDays ContentCalendar[]
  usageEvents  UsageEvent[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  // Drives the per-minute dispatch sweep: (cronTime IN window) AND isActive.
  @@index([cronTime, isActive])
}

model ContentCalendar {
  id                 String            @id @default(uuid())
  clientId           String
  client             Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dayNumber          Int
  scheduledDate      DateTime
  /// Short content angle for the day, fed to the poster-copy prompt.
  ///
  /// Nullable since the bulk importer stopped carrying it: a sheet now names the
  /// template it wants instead, and the copy stage anchors on the caption and the
  /// photo brief, which every row has. The AI calendar generator still writes one
  /// — it needs the value to keep 365 days from converging on the same angle.
  theme              String?
  caption            String            @db.Text
  hashtags           String
  // Background-photo prompt only. The poster's text is never diffusion-rendered;
  // it is composited as vector type from `posterCopy`.
  imagePrompt        String            @db.Text
  // Slot content for the poster layer: headline lines, accent line index, body,
  // feature items, CTA labels. Shape validated by `posterCopySchema`
  // (src/lib/types/poster.ts). Null on rows seeded before the poster layer
  // existed — `ensurePosterCopy` backfills them on first render.
  posterCopy         Json?
  /// The reference template this day's poster must be laid out from.
  ///
  /// Set only by a human — an imported sheet naming it, never a render. That is
  /// the difference from the retired `posterArchetype`, which the pipeline wrote
  /// back on first compose and which therefore froze a day's layout against every
  /// later change. Null means "rotate across the vertical's approved templates",
  /// which is what an AI-seeded calendar gets.
  ///
  /// SetNull rather than Restrict: retiring a template must not be blocked by the
  /// days that once used it, and a row falling back to the rotation is a better
  /// outcome than an undeletable row.
  posterTemplateId   String?
  posterTemplate     CategoryTemplate? @relation(fields: [posterTemplateId], references: [id], onDelete: SetNull)
  gDriveFileId       String? // Storage reference inside Google Drive
  gDriveViewUrl      String? // Public link used by Evolution API + the dashboard
  deliveryStatus     DeliveryStatus    @default(PENDING)
  /// Earliest instant the WhatsApp broadcast may go out, set when the poster
  /// reaches GENERATED. Generation runs at the client's exact `cronTime`; the
  /// send is held back by a random few minutes so a fleet of clients does not
  /// message WhatsApp in a synchronised burst on the same minute every day.
  ///
  /// Null means "send as soon as this row is processed" — every operator-driven
  /// path (retry, force re-send, regenerate, demo) leaves it null, because a
  /// human waiting on a button does not want a randomised delay. It is also null
  /// on rows written before this column existed, which is why the dispatch
  /// sweep's send phase requires a non-null value rather than treating null as
  /// due: those rows are historical failures and must not suddenly deliver.
  sendAfter          DateTime?
  /// Set when the operator approves this poster for delivery. Null means the
  /// asset exists but must not be broadcast.
  ///
  /// A nullable column rather than a fifth `DeliveryStatus`, because approval is
  /// orthogonal to where a row sits in the pipeline: a FAILED row keeps its
  /// approval across a retry, and a GENERATED row is the same state whether or
  /// not a human has looked at it yet.
  ///
  /// Backfilled to `createdAt` for every pre-existing row by the migration that
  /// adds it. That is not cosmetic — the dispatch sweep refuses to release an
  /// unapproved poster, so leaving live campaigns null would silently stop every
  /// paying client's delivery on deploy.
  approvedAt         DateTime?
  /// Set when the operator queues this day for batch pre-generation, cleared once
  /// the poster is rendered.
  ///
  /// A whole campaign is 30-365 renders at ~20s each, which no single request can
  /// hold open. So the console only marks the rows and returns; the sweep's
  /// backlog phase drains a few per minute. Restart-safe by construction — the
  /// mark is the queue, so a killed container resumes where it stopped.
  generationQueuedAt DateTime?
  errorMessage       String?           @db.Text
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([clientId, dayNumber])
  // Ultra-fast time-window scanning for the dispatch engine.
  @@index([scheduledDate, deliveryStatus])
  // Drives the send phase: "which generated posters are due to go out now",
  // asked once a minute and answered without touching scheduledDate — a send
  // held past midnight still belongs to the day it was generated for.
  @@index([deliveryStatus, sendAfter])
  // Drives the backlog phase: "which pending rows has the operator asked for",
  // asked once a minute against a column that is null for almost every row.
  @@index([deliveryStatus, generationQueuedAt])
  // Serves the SetNull cascade when a template is deleted.
  @@index([posterTemplateId])
}

/// One billable provider call. Append-only: rows are never updated, so the
/// ledger stays a faithful record of what was spent even as rates change.
model UsageEvent {
  id       String  @id @default(uuid())
  clientId String?
  // SetNull, not Cascade: money spent on a since-removed client still counts
  // toward the agency's total and must not disappear from the ledger.
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  /// Owning ContentCalendar day, when the spend belongs to one. Deliberately not
  /// a relation — deleting a failed calendar entry must not erase its cost.
  calendarId String?

  provider  UsageProvider
  /// Which stage spent it: "calendar", "brand-tokenizer", "image", "whatsapp".
  operation String
  /// Model or endpoint identifier, e.g. "gpt-4o-mini", "fal-ai/flux/schnell".
  model     String?

  inputTokens  Int @default(0)
  /// Subset of inputTokens served from OpenAI's prompt cache at a lower rate.
  cachedTokens Int @default(0)
  outputTokens Int @default(0)
  imageCount   Int @default(0)
  messageCount Int @default(0)

  /// Cost in USD millionths, priced at the rates in force when recorded.
  /// Integer micros avoid float drift across millions of summed rows.
  costUsdMicros Int @default(0)

  /// Reconstructed from historical calendar rows rather than observed at call
  /// time, so it carries an exact count but today's rate.
  backfilled Boolean @default(false)

  /// Which credential paid. PLATFORM rows are the agency's own spend and the only
  /// ones the cost report and the monthly budget alerts add up; BYO rows still
  /// carry their unit counts, so render volume stays visible even though the
  /// invoice lands on the operator's provider account rather than Evokz's.
  ///
  /// Only the image recorder sets this today. A future operator-supplied OpenAI
  /// key would have to teach `recordOpenAiUsage` the same thing — the default is
  /// a statement about the past, not a shortcut.
  ///
  /// Not indexed: two values across the whole ledger is the worst possible
  /// selectivity, and the indexes below still drive every query that filters it.
  keySource UsageKeySource @default(PLATFORM)

  createdAt DateTime @default(now())

  // Per-client spend over a window is the dashboard's hottest query.
  @@index([clientId, createdAt])
  @@index([provider, createdAt])
  @@index([createdAt])
}

/// Install-wide operator settings. Exactly one row, id "singleton".
///
/// Scope is the whole install, not the client: there is one operator and one
/// login, so a per-tenant credential would be a column nobody could fill in
/// differently. A typed singleton row rather than a key/value table because the
/// values are few and typed — the same reasoning that keeps `logoUrl` a column
/// instead of a slot inside `brandGuideline`.
model AppSetting {
  id String @id @default("singleton")

  /// AES-256-GCM envelope produced by src/lib/secret-box.ts, never plaintext.
  /// Null means no operator key, and the pipeline then uses the platform FAL_KEY.
  /// While it is set, FAL_KEY is deliberately never used — not even as a fallback
  /// when this key is rejected or cannot be decrypted.
  falKeyCipher    String?   @db.Text
  /// Last four characters of the key, so the console can identify which key is
  /// live without ever receiving the key itself.
  falKeyLast4     String?
  /// The operator's own note, e.g. "personal fal account".
  falKeyLabel     String?
  /// When the key was last written. Distinct from `updatedAt`, which will move
  /// for any future setting added to this row.
  falKeyUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
